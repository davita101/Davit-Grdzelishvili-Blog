# Public site URL, used for metadata, sitemap, RSS and OG images.
NEXT_PUBLIC_SITE_URL=
# PostHog project token (public). Leave unset locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# PostHog ingest host (public).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Lets agents reach protected Vercel previews. Never used in app code.
VERCEL_AUTOMATION_BYPASS_SECRET=
